{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/crabswarm.sh",
            "timeout": 300,
            "statusMessage": "Waiting for permission..."
          }
        ]
      }
    ]
  }
}
