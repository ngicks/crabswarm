{
  "description": "crabswarm chat wiring for Codex. Replace /path/to/crabswarm with this checkout before use; see plugin/README.md. Best-effort and unverified.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "crabswarm chat join >/dev/null 2>&1 || true",
            "timeout": 10,
            "statusMessage": "Joining the crabswarm chat room..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "crabswarm chat report-state running >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "crabswarm chat report-state waiting_input >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/crabswarm/plugin/scripts/chat-inbox-hint.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "crabswarm chat report-state running >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/path/to/crabswarm/plugin/scripts/chat-stop-drain.sh",
            "timeout": 10,
            "statusMessage": "Checking the crabswarm chat inbox..."
          }
        ]
      }
    ]
  }
}
