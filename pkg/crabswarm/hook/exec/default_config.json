    },
    {
      "ext": {"json": "json"},
      "root_markers": {"json": [[".git"]]}
    },
    {
      "ext": {"md": "markdown", "markdown": "markdown"},
      "root_markers": {"markdown": [[".git"]]}
    },
    {
      "filename": {"Makefile": "make"},
      "root_markers": {"make": [[".git"]]}
    },
    {
      "ext": {"mbt": "moonbit", "mbti": "moonbit"},
