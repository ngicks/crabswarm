      "root_markers": {"python": [["pyproject.toml", "setup.py"], [".git"]]}
    },
    {
      "ext": {"js": "javascript", "mjs": "javascript", "cjs": "javascript", "jsx": "javascript"},
      "filename": {"package.json": "javascript"},
      "root_markers": {"javascript": [["package.json"], [".git"]]}
    },
    {
      "ext": {"ts": "typescript", "tsx": "typescript", "mts": "typescript", "cts": "typescript"},
      "filename": {"tsconfig.json": "typescript"},
      "root_markers": {"typescript": [["tsconfig.json", "package.json"], [".git"]]}
    },
    {
      "ext": {"sh": "shell", "bash": "shell", "zsh": "shell"},
