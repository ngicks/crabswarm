# Node toolchain — never committed. src/gen/ and the packed dist.tar.zst ARE
# committed (the latter is embedded into the Go binary via embed.go); dist/
# itself is ignored, see the repo root .gitignore.
/node_modules

# MathJax component files copied from node_modules by scripts/copy-mathjax.mjs;
# regenerated on every build and served from web/dist after `vite build`.
/public/vendor

# Vite caches / local env
.vite
*.local

# Playwright run output (pnpm e2e)
/test-results
/playwright-report

# Presentation mocks under mock/<name>/ build and cache locally only
/mock/*/dist
/mock/*/.vite
