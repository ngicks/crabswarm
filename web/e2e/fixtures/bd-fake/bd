#!/bin/sh
# A stand-in for the beads CLI, so the issues e2e runs against the real daemon
# without a beads database. It answers the four subcommands crabswarm/issues
# builds — `where`, `list`, `show`, `dep list` — from the JSON under
# FAKE_BD_TESTDATA, which is recorded output of the real bd.
#
# Put this directory first on the daemon's PATH and point FAKE_BD_TESTDATA at
# web/e2e/fixtures/bd-data (playwright.config.ts does both).
set -e

if [ -z "$FAKE_BD_TESTDATA" ]; then
  echo "fake bd: FAKE_BD_TESTDATA is unset" >&2
  exit 2
fi

sub="$1"
shift

case "$sub" in
where)
  cat "$FAKE_BD_TESTDATA/where.json"
  ;;
list)
  # `--parent` narrows to one issue's children; nothing in this fixture has a
  # parent, so those listings are empty.
  for a in "$@"; do
    if [ "$a" = "--parent" ]; then
      echo '[]'
      exit 0
    fi
  done
  cat "$FAKE_BD_TESTDATA/list.json"
  ;;
show)
  # The service passes the id as `--id=<id>`; one recorded file per issue.
  id=
  for a in "$@"; do
    case "$a" in
    --id=*) id=${a#--id=} ;;
    esac
  done
  if [ -f "$FAKE_BD_TESTDATA/show_$id.json" ]; then
    cat "$FAKE_BD_TESTDATA/show_$id.json"
  else
    cat "$FAKE_BD_TESTDATA/show_not_found.json"
    echo "Error fetching $id: no issue found matching \"$id\"" >&2
    exit 1
  fi
  ;;
dep)
  verb="$1"
  if [ "$verb" != list ]; then
    echo "fake bd: unknown dep verb $verb" >&2
    exit 2
  fi
  # The flat batch shape real bd prints for two or more ids; the daemon
  # narrows the edges to the ids it asked about, so printing them all is safe.
  cat "$FAKE_BD_TESTDATA/dep_list.json"
  ;;
*)
  echo "fake bd: unknown subcommand $sub" >&2
  exit 2
  ;;
esac
exit 0
